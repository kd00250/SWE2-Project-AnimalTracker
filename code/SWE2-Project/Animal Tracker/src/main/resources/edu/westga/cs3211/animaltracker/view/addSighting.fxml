<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3211.animaltracker.view.AddSightingCodeBehind">

    <Label layoutX="265.0" layoutY="18.0" text="Add Sighting">
        <font>
            <Font size="32.0" />
        </font>
    </Label>

    <Button fx:id="backButton" layoutX="690.0" layoutY="18.0" mnemonicParsing="false" onAction="#onBackButtonClick" text="Back" />

    <VBox layoutX="60.0" layoutY="90.0" prefWidth="630.0" spacing="16.0">

        <VBox fillWidth="false" spacing="6.0">
            <Label text="Animal ID">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
         <TextField fx:id="animalTextField" promptText="Insert Tag ID" />
        </VBox>

        <VBox fillWidth="false" spacing="6.0">
            <Label text="Location">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
         <TextField fx:id="locationTextField" promptText="Insert Location" />
        </VBox>

        <VBox spacing="6.0">
            <Label text="Coordinates">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>

            <HBox spacing="12.0">
                <VBox spacing="4.0">
                    <Label text="Latitude" />
                    <TextField fx:id="latitudeTextField" prefWidth="180.0" promptText="Enter latitude..." />
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Longitude" />
                    <TextField fx:id="longitudeTextField" prefWidth="180.0" promptText="Enter longitude..." />
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Time">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>

            <HBox spacing="12.0">
                <VBox spacing="4.0">
                    <Label text="Date" />
                    <DatePicker fx:id="datePicker" prefWidth="200.0" />
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Hour" />
                    <Spinner fx:id="hourSpinner" prefWidth="90.0" />
                </VBox>

                <VBox spacing="4.0">
                    <Label text="Minute" />
                    <Spinner fx:id="minuteSpinner" prefWidth="90.0" />
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Note">
                <font>
                    <Font size="16.0" />
                </font>
            </Label>
            <TextArea fx:id="noteTextArea" prefHeight="140.0" promptText="Add any additional details about the sighting..." wrapText="true" />
        </VBox>

        <Label fx:id="warningLabel" textFill="RED" />

        <HBox prefWidth="630.0" spacing="12.0">
            <padding>
                <Insets top="8.0" />
            </padding>

            <Button fx:id="saveSightingButton" mnemonicParsing="false" onAction="#onSaveSightingClick" prefHeight="40.0" prefWidth="160.0" text="Save Sighting" />

            <Button fx:id="clearButton" mnemonicParsing="false" onAction="#onClearClick" prefHeight="40.0" prefWidth="120.0" text="Clear" />
        </HBox>
        <padding>
            <Insets bottom="5.0" />
        </padding>

    </VBox>

</AnchorPane>
