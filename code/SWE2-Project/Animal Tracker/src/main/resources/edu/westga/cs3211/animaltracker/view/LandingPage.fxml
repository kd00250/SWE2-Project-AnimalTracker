<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="565.0" prefWidth="449.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.westga.cs3211.animaltracker.view.LandingPageCodeBehind">
    <VBox alignment="TOP_CENTER" layoutX="76.0" layoutY="52.0" prefHeight="455.0" prefWidth="297.0">
        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="37.0" prefWidth="301.0"
               text="Animal Tracker" textAlignment="CENTER">
            <font>
                <Font size="20.0"/>
            </font>
        </Label>
        <VBox alignment="CENTER" prefHeight="423.0" prefWidth="297.0" spacing="20.0">
            <Button fx:id="viewProjectButton" mnemonicParsing="false" onAction="#onViewProjectClick"
                    prefHeight="61.0" prefWidth="248.0" text="Projects"/>
            <Button fx:id="addUserButton" mnemonicParsing="false" onAction="#onAddUserButtonClick"
                    prefHeight="61.0" prefWidth="248.0" text="Add User"/>
            <Button mnemonicParsing="false" onAction="#onLogoutClick" prefHeight="61.0" prefWidth="248.0"
                    text="Logout"/>
        </VBox>
    </VBox>
</AnchorPane>
