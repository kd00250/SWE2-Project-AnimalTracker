<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.westga.cs3211.animaltracker.view.CreateProjectCodeBehind">
    <children>
        <Button fx:id="backButton" layoutX="695.0" layoutY="14.0" mnemonicParsing="false" onAction="#onBackButtonClick"
                text="Back"/>
        <Button fx:id="createProjectButton" layoutX="330.0" layoutY="460.0" mnemonicParsing="false"
                onAction="#onCreateProjectClick" text="Create Project"/>
        <TextField fx:id="projectNameTextField" layoutX="48.0" layoutY="159.0"/>
        <TextField fx:id="projectLocationTextField" layoutX="48.0" layoutY="239.0"/>
        <Label fx:id="projectNameLabel" layoutX="48.0" layoutY="142.0" text="Project Name"/>
        <Label fx:id="projectLocationLabel" layoutX="48.0" layoutY="222.0" text="Project Location"/>
        <Label fx:id="projectNameWarningLabel" layoutX="48.0" layoutY="184.0" text="Invalid Name!"/>
        <Label fx:id="projectLocationWarningLabel" layoutX="48.0" layoutY="264.0" text="Invalid Location!"/>
        <ListView fx:id="availableScientistToAddListView" layoutX="579.0" layoutY="150.0" prefHeight="200.0"
                  prefWidth="149.0"/>
        <ListView fx:id="scientistToAddListView" layoutX="412.0" layoutY="150.0" prefHeight="200.0" prefWidth="149.0"/>
        <Label fx:id="scientistToAddLabel" layoutX="444.0" layoutY="133.0" text="Scientist to Add"/>
        <Label fx:id="availableScientistLabel" layoutX="603.0" layoutY="133.0" text="Available Scientists"/>
        <Button fx:id="removeScientistToAddButton" layoutX="433.0" layoutY="360.0" mnemonicParsing="false"
                onAction="#onRemoveScientistToAddClick" text="Remove Scientist"/>
        <Button fx:id="addScientistToProjectButton" layoutX="611.0" layoutY="360.0" mnemonicParsing="false"
                onAction="#onAddScientistToProjectClick" text="Add Scientist"/>
    </children>
</AnchorPane>
