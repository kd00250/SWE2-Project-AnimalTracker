<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="517.0" prefWidth="738.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3211.animaltracker.view.CreateTagCodeBehind">
   <children>
      <Label layoutX="302.0" layoutY="39.0" text="Create A New Tag">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <VBox alignment="CENTER_LEFT" layoutX="49.0" layoutY="62.0" prefHeight="118.0" prefWidth="114.0" spacing="10.0">
         <children>
            <Label text="Current Tag ID:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="tagId" text="123456789">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <Button fx:id="generateIdButton" mnemonicParsing="false" onAction="#onGenerateIdClick" text="Generate New ID" />
         </children>
      </VBox>
      <VBox layoutX="49.0" layoutY="172.0" prefHeight="96.0" prefWidth="114.0">
         <children>
            <Label prefHeight="27.0" prefWidth="121.0" text="Animal Class">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <ComboBox fx:id="speciesComboBox" prefWidth="150.0" />
         </children>
      </VBox>
      <VBox layoutX="252.0" layoutY="88.0" prefHeight="53.0" prefWidth="175.0">
         <children>
            <Label text="Height">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="heightTextField" prefHeight="25.0" prefWidth="68.0" promptText="Please enter in decimal form..." />
         </children>
      </VBox>
      <VBox layoutX="252.0" layoutY="141.0" prefHeight="53.0" prefWidth="175.0">
         <children>
            <Label text="Weight">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="weightTextField" promptText="Please enter in decimal form..." />
         </children>
      </VBox>
      <VBox layoutX="252.0" layoutY="194.0" prefHeight="53.0" prefWidth="175.0">
         <children>
            <Label text="Length">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="lengthTextField" promptText="Please enter in decimal form..." />
         </children>
      </VBox>
      <VBox layoutX="49.0" layoutY="283.0" prefHeight="200.0" prefWidth="411.0">
         <children>
            <Label text="Description:">
               <font>
                  <Font name="System Bold" size="17.0" />
               </font>
            </Label>
            <TextArea fx:id="descriptionText" prefHeight="200.0" prefWidth="200.0" />
         </children>
      </VBox>
      <VBox alignment="CENTER" layoutX="542.0" layoutY="141.0" prefHeight="210.0" prefWidth="175.0" spacing="50.0">
         <children>
            <Button fx:id="submitButton" mnemonicParsing="false" onAction="#onSubmitClick" prefHeight="46.0" prefWidth="113.0" text="Submit" />
            <Button mnemonicParsing="false" onAction="#onCancelClick" prefHeight="46.0" prefWidth="113.0" text="Cancel" />
         </children>
      </VBox>
      <VBox layoutX="45.0" layoutY="249.0" prefHeight="37.0" prefWidth="420.0">
         <children>
            <Label fx:id="errorLabel" prefHeight="32.0" prefWidth="420.0" textFill="RED" />
         </children>
      </VBox>
   </children>
</AnchorPane>
