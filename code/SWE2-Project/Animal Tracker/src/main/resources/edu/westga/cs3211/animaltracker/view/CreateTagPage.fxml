<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="535.0" prefWidth="442.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3211.animaltracker.view.CreateTagCodeBehind">
   <children>
      <Label layoutX="46.0" layoutY="27.0" prefHeight="32.0" prefWidth="222.0" text="Add Animal To Track">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <VBox alignment="CENTER_LEFT" layoutX="45.0" layoutY="56.0" prefHeight="118.0" prefWidth="114.0" spacing="10.0">
         <children>
            <Label text="Current Tag ID:">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <Label fx:id="tagId" text="******">
               <font>
                  <Font size="15.0" />
               </font>
            </Label>
            <Button fx:id="generateIdButton" mnemonicParsing="false" onAction="#onGenerateIdClick" text="Generate New ID" />
         </children>
      </VBox>
      <VBox layoutX="45.0" layoutY="180.0" prefHeight="96.0" prefWidth="114.0">
         <children>
            <Label prefHeight="27.0" prefWidth="121.0" text="Animal Class">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="speciesComboBox" prefWidth="150.0" />
         </children>
      </VBox>
      <VBox layoutX="177.0" layoutY="74.0" prefHeight="53.0" prefWidth="175.0">
         <children>
            <Label text="Height">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="heightTextField" prefHeight="25.0" prefWidth="68.0" promptText="Please enter in decimal form..." />
         </children>
      </VBox>
      <VBox layoutX="177.0" layoutY="127.0" prefHeight="53.0" prefWidth="175.0">
         <children>
            <Label text="Weight">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="weightTextField" promptText="Please enter in decimal form..." />
         </children>
      </VBox>
      <VBox layoutX="177.0" layoutY="186.0" prefHeight="53.0" prefWidth="175.0">
         <children>
            <Label text="Length">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="lengthTextField" promptText="Please enter in decimal form..." />
         </children>
      </VBox>
      <VBox layoutX="45.0" layoutY="276.0" prefHeight="166.0" prefWidth="351.0">
         <children>
            <Label text="Description:">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <TextArea fx:id="descriptionText" prefHeight="174.0" prefWidth="514.0" />
         </children>
      </VBox>
      <VBox layoutX="45.0" layoutY="239.0" prefHeight="37.0" prefWidth="351.0">
         <children>
            <Label fx:id="errorLabel" prefHeight="31.0" prefWidth="351.0" textFill="RED" />
         </children>
      </VBox>
      <Button fx:id="submitButton" layoutX="283.0" layoutY="460.0" mnemonicParsing="false" onAction="#onSubmitClick" prefHeight="46.0" prefWidth="113.0" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Submit" />
      <Button layoutX="46.0" layoutY="460.0" mnemonicParsing="false" onAction="#onClearClick" prefHeight="46.0" prefWidth="113.0" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Clear" />
      <Button fx:id="backButton" layoutX="305.0" layoutY="16.0" maxHeight="46.0" maxWidth="113.0" mnemonicParsing="false" onAction="#onBackClick" prefHeight="46.0" prefWidth="113.0" text="Back" />
   </children>
</AnchorPane>
